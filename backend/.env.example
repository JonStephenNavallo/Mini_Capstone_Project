# Copy this file to backend/.env for local production testing, or set these
# in Render Dashboard -> Service -> Environment.
# Never commit backend/.env to Git.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate a strong 50+ char key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-50-plus-character-random-secret-key

# Comma-separated hostnames (Render also auto-adds RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=your-render-app.onrender.com

# Comma-separated trusted origins (with https://). Add your Vercel frontend URL here!
CSRF_TRUSTED_ORIGINS=https://your-render-app.onrender.com,https://your-vercel-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-render-app.onrender.com,https://your-vercel-app.vercel.app

# PostgreSQL connection string (Neon / Supabase / Render Postgres).
# Recommended on Render because free-tier disk is ephemeral.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Persistent media storage on Render (free tier at https://cloudinary.com)
# Copy "API Environment variable" from Cloudinary Dashboard -> Settings -> API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Keep SSE rotation under Vercel proxy timeout (~25s on Hobby plan)
SSE_MAX_DURATION=20

# HTTPS hardening
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
