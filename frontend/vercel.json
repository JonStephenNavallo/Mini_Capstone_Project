{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://campus-lost-and-found-api-zxu8.onrender.com/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://campus-lost-and-found-api-zxu8.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://campus-lost-and-found-api-zxu8.onrender.com/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
